# Personal agent-session context — intentionally not checked in. The shared
# instructions are AGENTS.md; the opt-in Claude Code config sample lives in
# dev/claude/settings-review-gate.json (repo-native enforcement is AGENTS.md
# + the required review-gate CI check, not committed harness settings).
CLAUDE.md
.claude/

# Go build artifacts
bin/
dist/
*.test
*.out
coverage.*

# Built example binaries. dev/tools/build sends executables to a temp dir, but
# a bare `go build ./...` in a module holding one `package main` drops the
# binary in the working tree.
/antigravity-sdk-go
/pirate-math-mcp
/examples/deep_dives/observability_otel/observability_otel

# The precompiled localharness binary that dev/tools/fetch-harness unpacks
# from the published Python wheel for the live suite. 120 MB, platform
# specific, and reproducible from the version pinned in that script.
/dev/.harness/

# golangci-lint's cache, kept per-checkout by dev/tools/lint-go. Sharing one
# cache between checkouts makes it replay another directory's absolute paths,
# which silently defeats the path-based exclusions in .golangci.yml.
/dev/.lintcache/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
