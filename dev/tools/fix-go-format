# Reformat all Go source: gofmt -s + goimports (with local-prefix grouping).
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

ensure_tool goimports golang.org/x/tools/cmd/goimports@latest

# gofmt is part of the toolchain; goimports adds import grouping.
# Both are idempotent. The local prefix puts this module's own imports in
# their own group, which for the examples means the SDK sorts after the
# standard library and before nothing else.
#
# internal/genproto is left alone for the reason in verify-go-format: it is
# generated, and reformatting it only guarantees a diff after the next
# `buf generate`.
mapfile -t files < <(
  find . -name '*.go' -not -path './.git/*' -not -path './internal/genproto/*' -print | sort
)

gofmt -s -w "${files[@]}"
goimports -w -local github.com/go-steer/antigravity-sdk-go "${files[@]}"
