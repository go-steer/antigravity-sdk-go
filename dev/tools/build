# Compile every package in every module. Catches packages that don't build
# but have no tests — which is most of examples/.
#
# Executables go to a temp directory. `go build ./...` discards the result
# when it names several packages, but a module holding exactly one `package
# main` — examples/deep_dives/observability_otel — gets its binary written
# into the working tree instead, which is how 15MB lands in a `git add -A`.
# `-o <dir>/` moves it somewhere disposable, and errors out where there is no
# main package at all, hence the check.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

build_module() {
  if [[ -n "$(go list -f '{{if eq .Name "main"}}x{{end}}' ./...)" ]]; then
    go build -o "$WORKDIR/" ./...
  else
    go build ./...
  fi
}

for_each_module build build_module
