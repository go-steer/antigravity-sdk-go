# Local CI runner — executes every check the GitHub Actions workflow runs,
# in fast-fail order. Mirrors dev/ci/presubmits/* so a green run here
# means a green run there.
#
# Every step covers all three modules. `go build ./...` from the root
# reaches neither tracing/ nor the example that imports it, so a check that
# forgot to loop would be quietly measuring two thirds of the repo.
#
# Usage:
#   dev/tools/ci                    # run everything, stop on first failure
#   dev/tools/ci --keep-going       # report all failures (don't stop early)
#   ANTIGRAVITY_CI_SKIP="apidiff" ...  # omit named steps
set -euo pipefail
. "$(dirname "$0")/common.sh"

cd "$(repo_root)"

KEEP_GOING=0
for arg in "$@"; do
  case "$arg" in
    --keep-going) KEEP_GOING=1 ;;
    -h|--help)
      echo "Usage: dev/tools/ci [--keep-going]"
      exit 0
      ;;
    *)
      echo "Unknown flag: $arg" >&2
      exit 2
      ;;
  esac
done

# Order matters: cheap, format-style checks first; the slow scanners last.
# One entry per step: "<label> <script>".
STEPS=(
  "format    dev/tools/verify-go-format"
  "vet       dev/tools/vet"
  "build     dev/tools/build"
  "lint      dev/tools/lint-go"
  "mod-tidy  dev/tools/verify-mod-tidy"
  # Measures the working tree against the last release tag, so it reflects
  # uncommitted edits — which is the point of running it before you push.
  "apidiff   dev/tools/verify-apidiff"
  "test      dev/tools/test-unit"
  # Immediately after `test`, which wrote the profile it reads. Run alone it
  # would generate its own; here it never has to.
  "coverage  dev/tools/verify-coverage"
  "vuln      dev/tools/verify-vuln"
)

# There is no live step here, and that is deliberate — but not because a
# live run is impossible. It is: the precompiled `localharness` binary ships
# inside the published `google-antigravity` Python wheel, dev/tools/
# fetch-harness unpacks it, and dev/tools/test-live drives the end-to-end
# suite in livetest/ against it.
#
# It stays out of this sweep because it needs credentials and costs money
# per run, and because it can go red for reasons no PR caused — a quota, a
# backend outage, a model deprecation. A gate that fails on a datacenter
# hiccup is a gate people learn to ignore. Run dev/tools/test-live by hand
# before a release, and after touching the wire layer.
#
# What remains covered here is the same seam as before: internal/harness's
# fake harness speaks the real protocol over a real local socket, so the
# handshake and WebSocket framing are exercised without credentials.

# ANTIGRAVITY_CI_SKIP is a space-separated list of labels to omit. It exists
# for one caller: .github/workflows/ci.yml skips `apidiff`, which runs as its
# own job there because it needs the full history (fetch-depth: 0) that the
# main job does not pay for — and because it is deliberately not a required
# check. Keeping the step list in one place means the local sweep can't drift
# from the remote one; only the skip is declared at the call site.
SKIP="${ANTIGRAVITY_CI_SKIP:-}"

skipped=()
failures=()
for entry in "${STEPS[@]}"; do
  label="${entry%% *}"
  cmd="${entry#"$label"}"
  cmd="${cmd# }"
  cmd="${cmd##*[[:space:]]}"

  if [[ " $SKIP " == *" $label "* ]]; then
    skipped+=("$label")
    continue
  fi

  if run_step "$label" "$cmd"; then
    continue
  fi
  failures+=("$label")
  if [[ "$KEEP_GOING" -eq 0 ]]; then
    echo
    echo "✗ $label failed — aborting (pass --keep-going to run all checks)" >&2
    exit 1
  fi
done

echo
if [[ "${#skipped[@]}" -gt 0 ]]; then
  printf '· skipped (ANTIGRAVITY_CI_SKIP): %s\n' "${skipped[*]}"
fi
if [[ "${#failures[@]}" -eq 0 ]]; then
  echo "✓ all CI checks passed"
else
  printf '✗ failures: %s\n' "${failures[*]}" >&2
  exit 1
fi
