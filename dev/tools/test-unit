# Run the unit test suite with -race + atomic coverage, in every module.
#
# Writes a single merged coverage.out at the repo root for
# dev/tools/verify-coverage. Per-module profiles merge cleanly because
# every block is keyed by full import path, and the modules do not
# overlap.
#
# The suite needs no network, no credentials, and no localharness binary:
# anything touching the transport runs against the fake harness in
# internal/harness, which performs the real handshake over a real local
# WebSocket.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

while read -r mod; do
  printf '  · test (%s)\n' "$mod"
  out="$WORKDIR/$(printf '%s' "$mod" | tr '/.' '__').out"
  ( cd "$mod" && go test -race -timeout 5m \
      -coverprofile="$out" -covermode=atomic \
      ./... )
done < <(modules)

# Merge: one `mode:` line, then every block from every profile. A module
# whose packages have no tests contributes only the header, which drops out
# here.
{
  echo "mode: atomic"
  cat "$WORKDIR"/*.out | grep -v '^mode:' || true
} > coverage.out
